#!/bin/sh
# After a merge or a pull, names the AI setup files that changed, so an agent re-reads them. Turned on by
# `node tools/setup.ts`. Only informs: always exits 0.
cd "$(git rev-parse --show-toplevel)" || exit 0
if ! command -v node >/dev/null 2>&1; then
  echo "post-merge: node not found, hook skipped" >&2
  exit 0
fi
[ -f tools/hooks.ts ] && node tools/hooks.ts post-merge "$@"
exit 0
