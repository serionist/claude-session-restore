#!/bin/sh
# Runs the gate's quick lane on what the push sends. Turned on by `node tools/setup.ts`.
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found, hook skipped: the gate did not run (https://nodejs.org)" >&2
  exit 0
fi
[ -f tools/hooks.ts ] || exit 0
exec node tools/hooks.ts pre-push "$@"
