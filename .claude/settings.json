{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --name-only)",
      "Bash(git diff --cached*)",
      "Bash(git diff HEAD)",
      "Bash(git diff HEAD *)",
      "Bash(git diff origin/main...HEAD*)",
      "Bash(git diff --stat origin/main...HEAD*)",
      "Bash(git diff --name-only origin/main...HEAD*)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list*)",
      "Bash(git fetch origin)",
      "Bash(gh issue view *)",
      "Bash(gh issue list*)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list*)",
      "Bash(npm ci)",
      "Bash(node tools/gate.ts quick*)",
      "Bash(node tools/gate.ts full*)",
      "Bash(node --test tools/*)",
      "Bash(npm run claude -- plugin test plugin)",
      "Bash(npm run claude -- plugin validate *)",
      "Bash(npx biome ci*)",
      "Bash(npx biome lint*)",
      "Bash(npx tsc -p .)",
      "Bash(npx tsc -p plugin)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.token)",
      "Read(**/.claude/settings.local.json)",
      "Bash(git diff --no-index*)",
      "Bash(git diff *--no-index*)",
      "Bash(git diff --output*)",
      "Bash(git diff *--output*)",
      "Bash(git log --output*)",
      "Bash(git log *--output*)",
      "Bash(git show --output*)",
      "Bash(git show *--output*)",
      "Bash(git blame --contents*)",
      "Bash(git blame *--contents*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git push *--no-verify*)",
      "Bash(npx biome *--write*)",
      "Bash(npx biome *--unsafe*)",
      "Bash(npm *--ignore-scripts=false*)"
    ]
  }
}
