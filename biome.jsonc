// Lint and format for the plugin and the tools, run by the gate as `biome ci`. Markdown is written by hand.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!plugin/.claude-plugin/types", "!**/*.md"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      // The hooks module draws with Claude Code's own elements, not the DOM: a Button's `role` is the engine's
      // ("dismiss"), not an ARIA role, so the accessibility rules read it wrong.
      "includes": ["plugin/hooks/**"],
      "linter": {
        "rules": {
          "a11y": "off"
        }
      }
    }
  ]
}
